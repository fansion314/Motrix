# Maintainer: fansion314 <https://github.com/fansion314>
pkgname=motrix-electron
pkgver=2.0.0beta.46
pkgrel=2
_version=2.0.0-beta.46
_tag=arch-v${_version}-${pkgrel}
pkgdesc='Motrix download manager using system Electron and bundled Motrix aria2'
arch=('x86_64')
url='https://github.com/fansion314/Motrix'
license=('MIT' 'GPL-2.0-or-later')
depends=('electron' 'gcc-libs' 'glibc' 'xdg-utils')
makedepends=('git' 'nodejs' 'pnpm' 'python' 'rust' 'asar')
optdepends=('libayatana-appindicator: system tray integration' 'ffmpeg: media downloads')
provides=("motrix=${pkgver}" "motrix2=${pkgver}")
conflicts=('motrix' 'motrix-bin' 'motrix-git' 'motrix-beta-bin' 'motrix2' 'motrix2-bin' 'motrix-electron-bin')
options=('!strip')
source=("Motrix::git+${url}.git#tag=${_tag}")
sha256sums=('SKIP')

prepare() {
  cd Motrix
  export ELECTRON_SKIP_BINARY_DOWNLOAD=1
  export MOTRIX_SKIP_ELECTRON_REBUILD=1
  export MOTRIX_SKIP_ENGINE_FETCH=1
  pnpm install --frozen-lockfile
}

build() {
  cd Motrix
  MOTRIX_ARCH_PKGREL="$pkgrel" pnpm run build:arch
}

check() {
  cd Motrix
  pnpm run verify:arch -- "release/motrix-electron-${_version}-${pkgrel}-x86_64.asar"
}

package() {
  asar extract "Motrix/release/motrix-electron-${_version}-${pkgrel}-x86_64.asar" "$pkgdir"
}
