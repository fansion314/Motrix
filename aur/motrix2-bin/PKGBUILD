# Maintainer: fansion314 <https://github.com/fansion314>
pkgname=motrix2-bin
pkgver=2.0.0beta.41
pkgrel=2
_version=2.0.0-beta.41
_tag=arch-v${_version}-${pkgrel}
pkgdesc='Motrix 2 download manager using system Electron and bundled Motrix aria2 (prebuilt ASAR)'
arch=('x86_64')
url='https://github.com/fansion314/Motrix'
license=('MIT' 'GPL-2.0-or-later')
depends=('electron' 'gcc-libs' 'glibc' 'xdg-utils')
makedepends=('asar')
optdepends=('libayatana-appindicator: system tray integration' 'ffmpeg: media downloads')
provides=("motrix=${pkgver}" "motrix2=${pkgver}")
conflicts=('motrix' 'motrix-bin' 'motrix-git' 'motrix-beta-bin' 'motrix2')
options=('!strip')
source=("${url}/releases/download/${_tag}/motrix2-${_version}-${pkgrel}-x86_64.asar")
noextract=("motrix2-${_version}-${pkgrel}-x86_64.asar")
# Replaced with the verified release digest by arch-release.yml.
sha256sums=('a8524e30d0aecf9047325a323382b664350e770f0d326aa333bae47bd8bdf6e3')

package() {
  asar extract "motrix2-${_version}-${pkgrel}-x86_64.asar" "$pkgdir"
  mv "$pkgdir/usr/share/licenses/motrix2" "$pkgdir/usr/share/licenses/$pkgname"
}
